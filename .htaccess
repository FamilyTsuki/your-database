RewriteEngine On

# Autoriser les fichiers et dossiers existants
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Autoriser l'accès direct au dossier public/
RewriteRule ^public/ - [L]

# Rediriger les pages publiques vers public/ (login, register, logout)
RewriteRule ^(login|register|logout)\.php$ public/$1.php [QSA,L]

# Rediriger les fichiers statiques vers public/
RewriteRule ^(css|js|img|uploads)/ public/$0 [QSA,L]

# Par défaut vers public/index.php
RewriteRule ^$ public/index.php [L]