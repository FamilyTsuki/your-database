Options -MultiViews
RewriteEngine On

# Si le fichier ou dossier existe physiquement, on ne fait rien (ex: css, js, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Routes spécifiques pour les bases de données (URLs propres)
RewriteRule ^database/settings/([0-9]+)$ database-settings.php?id=$1 [L,QSA]
RewriteRule ^database/add/([0-9]+)$ database-ajouter.php?id=$1 [L,QSA]
RewriteRule ^database/([0-9]+)$ database-view.php?id=$1 [L,QSA]

# Suppression de l'extension .php pour toutes les autres pages (login, profile, etc.)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]